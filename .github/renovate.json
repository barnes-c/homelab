{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":dependencyDashboard",
        "helpers:pinGitHubActionDigests"
    ],
    "labels": [
        "dependencies"
    ],
    "dependencyDashboardLabels": [
        "dependencies"
    ],
    "pinDigests": true,
    "hostRules": [
        {
            "matchHost": "ghcr.io",
            "hostType": "docker"
        }
    ],
    "argocd": {
        "managerFilePatterns": [
            "/apps/.*\\.yaml$/"
        ]
    },
    "kubernetes": {
        "managerFilePatterns": [
            "/manifests/.*\\.yaml$/"
        ]
    },
    "terraform": {
        "managerFilePatterns": [
            "/tofu/.*\\.tf$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/manifests/infrastructure/monitoring/.*/config\\.json$/"
            ],
            "matchStrings": [
                "\"repoURL\":\\s*\"(?<registryUrl>[^\"]+)\",\\s*\"chart\":\\s*\"(?<depName>[^\"]+)\",\\s*\"chartVersion\":\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "helm"
        },
        {
            "description": "Container images run via `docker run` in workflow scripts, which the github-actions manager does not parse.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/"
            ],
            "matchStrings": [
                "(?<depName>(?:docker\\.io|ghcr\\.io)/[a-z0-9._/-]+):(?<currentValue>[A-Za-z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": "Automerge patches once they have been public for 3 days.",
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "minimumReleaseAge": "3 days"
        },
        {
            "description": "immich-server has v3.3.5 files mounted over it, which break on any other version. Remove with barnes-c/homelab-issues#51.",
            "matchDepNames": [
                "ghcr.io/immich-app/immich-server"
            ],
            "automerge": false
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions"
        },
        {
            "matchManagers": [
                "docker"
            ],
            "matchDatasources": [
                "docker"
            ],
            "groupName": "docker-images"
        },
        {
            "matchManagers": [
                "argocd"
            ],
            "groupName": "argocd-apps",
            "labels": [
                "dependencies",
                "argocd"
            ]
        },
        {
            "description": "authentik rejects migrations that skip a release, so it must be upgraded one minor at a time and never grouped with the other argocd apps.",
            "matchManagers": [
                "argocd"
            ],
            "matchDepNames": [
                "authentik"
            ],
            "groupName": "authentik",
            "separateMultipleMinor": true,
            "automerge": false
        },
        {
            "matchManagers": [
                "argocd"
            ],
            "matchDepNames": [
                "https://github.com/barnes-c/homelab"
            ],
            "enabled": false
        },
        {
            "description": "Tofu-managed (Cilium, Talos provider): only applied by a manual tofu apply, so an automerged bump would land silently with the next unrelated apply.",
            "matchManagers": [
                "terraform"
            ],
            "automerge": false
        }
    ]
}
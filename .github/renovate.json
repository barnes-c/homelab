{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "github>barnes-c/renovate-config"
    ],
    "argocd": {
        "managerFilePatterns": [
            "/apps/.*\\.yaml$/"
        ]
    },
    "kubernetes": {
        "managerFilePatterns": [
            "/manifests/.*\\.yaml$/"
        ]
    },
    "terraform": {
        "managerFilePatterns": [
            "/tofu/.*\\.tf$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/manifests/infrastructure/monitoring/.*/config\\.json$/"
            ],
            "matchStrings": [
                "\"repoURL\":\\s*\"(?<registryUrl>[^\"]+)\",\\s*\"chart\":\\s*\"(?<depName>[^\"]+)\",\\s*\"chartVersion\":\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "helm"
        }
    ],
    "packageRules": [
        {
            "description": "immich-server has v3.4.2 files mounted over it, which break on any other version. Remove with barnes-c/homelab-issues#51.",
            "matchDepNames": [
                "ghcr.io/immich-app/immich-server"
            ],
            "automerge": false
        },
        {
            "description": "Tags are <postgres major>-vectorchord<x.y.z>; extra suffixes (-pgvector…) don't match and are ignored.",
            "matchDepNames": [
                "ghcr.io/immich-app/postgres"
            ],
            "versioning": "regex:^(?<major>\\d+)-vectorchord(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
        },
        {
            "description": "A Postgres major needs a dump and restore onto a new volume, not a tag bump.",
            "matchDepNames": [
                "ghcr.io/immich-app/postgres"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        },
        {
            "matchManagers": [
                "argocd"
            ],
            "groupName": "argocd-apps",
            "labels": [
                "dependencies",
                "argocd"
            ]
        },
        {
            "description": "authentik rejects migrations that skip a release, so it must be upgraded one minor at a time and never grouped with the other argocd apps.",
            "matchManagers": [
                "argocd"
            ],
            "matchDepNames": [
                "authentik"
            ],
            "groupName": "authentik",
            "separateMultipleMinor": true,
            "automerge": false
        },
        {
            "description": "Longhorn only supports upgrading one minor at a time, and preUpgradeChecker is off under ArgoCD, so nothing in-cluster blocks a skipped minor. See barnes-c/homelab-issues#57.",
            "matchManagers": [
                "argocd"
            ],
            "matchDepNames": [
                "longhorn"
            ],
            "groupName": "longhorn",
            "separateMultipleMinor": true
        },
        {
            "matchManagers": [
                "argocd"
            ],
            "matchDepNames": [
                "https://github.com/barnes-c/homelab"
            ],
            "enabled": false
        },
        {
            "description": "Tofu-managed (Cilium, Talos provider): only applied by a manual tofu apply, so an automerged bump would land silently with the next unrelated apply.",
            "matchManagers": [
                "terraform"
            ],
            "automerge": false
        }
    ]
}
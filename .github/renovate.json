{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":dependencyDashboard",
        "helpers:pinGitHubActionDigests"
    ],
    "labels": [
        "dependencies"
    ],
    "dependencyDashboardLabels": [
        "dependencies"
    ],
    "pinDigests": true,
    "platformAutomerge": true,
    "internalChecksFilter": "strict",
    "hostRules": [
        {
            "matchHost": "ghcr.io",
            "hostType": "docker"
        }
    ],
    "argocd": {
        "managerFilePatterns": [
            "/apps/.*\\.yaml$/"
        ]
    },
    "kubernetes": {
        "managerFilePatterns": [
            "/manifests/.*\\.yaml$/"
        ]
    },
    "terraform": {
        "managerFilePatterns": [
            "/tofu/.*\\.tf$/"
        ]
    },
    "customManagers": [
        {
            "customType": "regex",
            "managerFilePatterns": [
                "/manifests/infrastructure/monitoring/.*/config\\.json$/"
            ],
            "matchStrings": [
                "\"repoURL\":\\s*\"(?<registryUrl>[^\"]+)\",\\s*\"chart\":\\s*\"(?<depName>[^\"]+)\",\\s*\"chartVersion\":\\s*\"(?<currentValue>[^\"]+)\""
            ],
            "datasourceTemplate": "helm"
        },
        {
            "description": "Container images run via `docker run` in workflow scripts, which the github-actions manager does not parse.",
            "customType": "regex",
            "managerFilePatterns": [
                "/^\\.github/workflows/.+\\.ya?ml$/"
            ],
            "matchStrings": [
                "(?<depName>(?:docker\\.io|ghcr\\.io)/[a-z0-9._/-]+):(?<currentValue>[A-Za-z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
            ],
            "datasourceTemplate": "docker"
        }
    ],
    "packageRules": [
        {
            "description": "Automerge patches once they have been public for 1 day.",
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true,
            "minimumReleaseAge": "1 day"
        },
        {
            "description": "immich-server has v3.4.1 files mounted over it, which break on any other version. Remove with barnes-c/homelab-issues#51.",
            "matchDepNames": [
                "ghcr.io/immich-app/immich-server"
            ],
            "automerge": false
        },
        {
            "description": "Tags are <postgres major>-vectorchord<x.y.z>; extra suffixes (-pgvector…) don't match and are ignored.",
            "matchDepNames": [
                "ghcr.io/immich-app/postgres"
            ],
            "versioning": "regex:^(?<major>\\d+)-vectorchord(?<minor>\\d+)\\.(?<patch>\\d+)\\.(?<build>\\d+)$"
        },
        {
            "description": "A Postgres major needs a dump and restore onto a new volume, not a tag bump.",
            "matchDepNames": [
                "ghcr.io/immich-app/postgres"
            ],
            "matchUpdateTypes": [
                "major"
            ],
            "dependencyDashboardApproval": true
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github-actions"
        },
        {
            "matchManagers": [
                "docker"
            ],
            "matchDatasources": [
                "docker"
            ],
            "groupName": "docker-images"
        },
        {
            "matchManagers": [
                "argocd"
            ],
            "groupName": "argocd-apps",
            "labels": [
                "dependencies",
                "argocd"
            ]
        },
        {
            "description": "authentik rejects migrations that skip a release, so it must be upgraded one minor at a time and never grouped with the other argocd apps.",
            "matchManagers": [
                "argocd"
            ],
            "matchDepNames": [
                "authentik"
            ],
            "groupName": "authentik",
            "separateMultipleMinor": true,
            "automerge": false
        },
        {
            "matchManagers": [
                "argocd"
            ],
            "matchDepNames": [
                "https://github.com/barnes-c/homelab"
            ],
            "enabled": false
        },
        {
            "description": "Tofu-managed (Cilium, Talos provider): only applied by a manual tofu apply, so an automerged bump would land silently with the next unrelated apply.",
            "matchManagers": [
                "terraform"
            ],
            "automerge": false
        }
    ]
}